# Fastlane dotenv template for Pastura's release (ADR-014).
#
# Copy this to `fastlane/.env` (gitignored) and fill in your own values:
#     cp fastlane/.env.example fastlane/.env
# NEVER commit the real fastlane/.env. Full setup: docs/release-setup.md.
#
# fastlane auto-loads fastlane/.env (dotenv, same dir as the Fastfile), so
# scripts/release.sh and the Fastfile see these without any shell export.
#
# These are IDENTIFIERS, not the secret itself: the actual private key is the
# .p8 file, which stays OUTSIDE the repo (~/.appstoreconnect/private_keys/);
# only its absolute path is referenced here.

# The API key's Key ID (10 chars; the part after "AuthKey_" in the filename).
ASC_KEY_ID=XXXXXXXXXX

# The Issuer ID (a UUID shown above the keys table in App Store Connect).
ASC_ISSUER_ID=00000000-0000-0000-0000-000000000000

# Absolute path to the .p8 (no ~/$HOME — dotenv does not reliably expand them).
ASC_KEY_PATH=/Users/you/.appstoreconnect/private_keys/AuthKey_XXXXXXXXXX.p8
