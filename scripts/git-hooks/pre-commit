#!/usr/bin/env bash
#
# scripts/git-hooks/pre-commit — Pastura pre-commit gate.
#
# Runs the project's mandatory pre-commit checks in fail-fast order.
# Migrated from `.claude/settings.json` PreToolUse Bash hooks (#406 →
# #407 → this PR's #410) because Claude Code's `if` field gating
# fails-open on complex Bash commands, which surfaced these gates'
# error messages on non-`git commit` invocations ("SwiftLint
# violations. Fix before committing." appearing on `xcodebuild test`,
# etc.). git's pre-commit fires only on `git commit`, so the gating is
# tight by construction.
#
# Reference: PR #410 (hooks migration).
#
# Activation:
#   - `scripts/setup.sh` runs `git config core.hooksPath scripts/git-hooks`
#     once per clone. After that, this script fires automatically on
#     every `git commit`.
#   - `.git/hooks/` is NOT used because it isn't repo-tracked; pinning
#     hooks here lets every contributor share the same gate set.
#   - Override: `git commit --no-verify` bypasses (CLAUDE.md prohibits).

set -euo pipefail

# Run from the repo root regardless of where `git commit` was invoked
# (subdirectories, submodules, etc.).
cd "$(git rev-parse --show-toplevel)"

# Classify the staged changeset (#625). SwiftLint and the iOS build are
# the expensive steps, and neither can be affected by a changeset that
# touches no Swift / build-relevant files (e.g. web/, docs/, .github/,
# .claude/). Gate them on the classifier, which is conservative by
# inversion — any unrecognized path forces the full gate. The blocklist /
# gallery / p8 sub-gates below stay UNCONDITIONAL: they already self-gate
# on their own inputs, and the p8 secret gate must always run.
# `-c core.quotepath=false`: emit non-ASCII paths (e.g. a Japanese-named
# Swift file) literally instead of octal-escaped + double-quoted, so the
# classifier's `\.swift$` anchor still matches and lint fires. Without it
# such a path would only force `build` (safe, but lint would be skipped).
staged="$(git -c core.quotepath=false diff --cached --name-only)"
gates="$(printf '%s\n' "$staged" | bash scripts/precommit-gate-classify.sh)"

# 1. SwiftLint --strict — surface lint violations before they hit CI.
case " $gates " in
  *" lint "*)
    swiftlint lint --quiet --strict 2>&1 \
      || { echo 'SwiftLint violations. Fix before committing.' >&2; exit 2; }
    ;;
  *)
    echo 'pre-commit: no Swift / .swiftlint.yml staged — skipping SwiftLint.'
    ;;
esac

# 2. xcodebuild build — catch compile errors at commit time, not CI time.
# PASTURA_SKIP_XCSTRINGS_SYNC keeps the catalog stable across commits.
case " $gates " in
  *" build "*)
    PASTURA_SKIP_XCSTRINGS_SYNC=1 ./scripts/xcodebuild.sh build -quiet 2>&1 \
      || { echo 'Build failed. Fix compile errors before committing.' >&2; exit 2; }
    ;;
  *)
    echo 'pre-commit: no build-relevant files staged — skipping xcodebuild build.'
    ;;
esac

# 3. Blocklist gate (ADR-005) — fails-fast inside.
bash ./scripts/blocklist-precommit-gate.sh

# 4. Gallery gate (curated scenario YAML schema) — fails-fast inside.
bash ./scripts/gallery-precommit-gate.sh

# 5. Secret gate (ADR-014) — block *.p8 ASC / APNs keys. Fails-fast inside.
bash ./scripts/p8-precommit-gate.sh

# 6. Navigation-map drift gate (#652) — self-gates on nav-map inputs,
# fails-fast inside. Mirrors the CI navigation-map-drift job locally.
bash ./scripts/navigation-map-precommit-gate.sh

# 7. ScenarioEditor funnel tripwire (#338) — self-gates on
# ScenarioEditorViewModel*.swift, fails-fast inside. Mirrors the CI
# scenario-editor-funnel-drift job locally.
bash ./scripts/scenario-editor-funnel-gate.sh

# 8. Scenario-format coverage gate (#1120) — self-gates on the PhaseType /
# ScoreCalcLogic enums and the web scenario-format.<locale>.md, fails-fast
# inside. Mirrors the CI scenario-format-coverage job locally.
bash ./scripts/scenario-format-coverage-precommit-gate.sh

# 9. OutputSchema production-serialization gate (ADR-023 §12 cond.1) — self-gates
# on any production Swift/Kotlin source (the check's whole input is the
# production tree), fails-fast inside. Mirrors the CI outputschema-serialization
# job locally.
bash ./scripts/outputschema-serialization-precommit-gate.sh

# 10. ADR-023 §4 port-disposition coverage gate (#1191) — self-gates on any
# Engine/** or LLM/** Swift file, the ledger, or the checker; fails-fast inside.
# Mirrors the CI adr023-port-coverage job locally.
bash ./scripts/adr023-port-coverage-precommit-gate.sh
