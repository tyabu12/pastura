          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: output フィールド名 '%2$@' は ASCII 識別子（英字・数字・アンダースコアのみ。数字またはアンダースコアで始めることはできません）である必要があります。エージェントのテキスト値は任意の言語で構いません。"
          }
        }
      }
    },
