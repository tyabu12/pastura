        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@: target が random_one の場合、source '%2$@' はグループ化された値（例: 多数派/少数派のペア）のリストである必要があります。"
          }
        }
      }
    },
