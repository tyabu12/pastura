{
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git show*)",
      "Bash(git branch*)",
      "Bash(git rev-parse*)",
      "Bash(git remote -v*)",
      "Bash(git fetch*)",
      "Bash(git add*)",
      "Bash(git commit*)",
      "Bash(git stash list*)",
      "Bash(git stash show*)",
      "Bash(git worktree*)",
      "Bash(git blame*)",
      "Bash(git ls-files*)",
      "Bash(git switch -)",
      "Bash(git switch main)",
      "Bash(git switch feature/*)",
      "Bash(git switch fix/*)",
      "Bash(git switch docs/*)",
      "Bash(git switch -c feature/*)",
      "Bash(git switch -c fix/*)",
      "Bash(git switch -c docs/*)",
      "Bash(git switch -c agent/*)",
      "Bash(git switch agent/*)",
      "Bash(git switch -c audit/*)",
      "Bash(git switch audit/*)",
      "Bash(git push -u origin agent/*)",
      "Bash(git push -u origin audit/*)",
      "Bash(scripts/xcodebuild.sh*)",
      "Bash(xcodebuild -list*)",
      "Bash(xcodebuild -showBuildSettings*)",
      "Bash(xcrun simctl list*)",
      "Bash(swift build*)",
      "Bash(swift test*)",
      "Bash(swift package*)",
      "Bash(swiftlint*)",
      "Bash(swift-format*)",
      "Bash(source scripts/sim-dest.sh)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "Bash(gh pr diff*)",
      "Bash(gh pr checks*)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue edit*)",
      "Bash(gh issue comment*)",
      "Bash(gh issue create*)",
      "Bash(gh issue reopen*)",
      "Bash(gh pr create --draft*)",
      "Bash(gh pr create --base*)",
      "Bash(gh label list*)",
      "Bash(git cat-file -e origin/main:.github/ISSUE_TEMPLATE/agent-task.yml)",
      "Bash(python3 .claude/skills/queue-consumer/scripts/*)",
      "Bash(python3 .claude/skills/consistency-audit/scripts/*)",
      "Bash(python3 .claude/skills/scenario-factory/scripts/*)",
      "Bash(bash .claude/skills/scenario-factory/scripts/run_scenario.sh)",
      "Bash(bash .claude/skills/queue-consumer/tests/run_tests.sh)",
      "Bash(bash .claude/skills/consistency-audit/tests/run_tests.sh)",
      "Bash(bash .claude/skills/scenario-factory/tests/run_tests.sh)",
      "Bash(gh run view*)",
      "Bash(gh run list*)",
      "Bash(gh run watch*)",
      "Bash(ls *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(wc *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd $(git rev-parse --show-toplevel) && bash scripts/hooks/gated-runner.sh 'gh pr create' -- bash scripts/hooks/check-claude-md-modified.sh"
          },
          {
            "type": "command",
            "command": "cd $(git rev-parse --show-toplevel) && bash scripts/hooks/block-force-push-and-pr-ready.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "echo '{\"hookSpecificOutput\":{\"hookEventName\":\"SessionStart\",\"additionalContext\":\"Reminder: This is Pastura (Swift/iOS). Follow CLAUDE.md hard rules. No force unwrap (!), no Engine→Data imports, TDD mandatory for Engine/LLM layers.\"}}'"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "cd $(git rev-parse --show-toplevel) && bash scripts/hooks/gated-runner.sh 'gh pr create --base' -- bash scripts/hooks/pr-created-reflection.sh"
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.tool_input.file_path | select(endswith(\".swift\"))' | xargs -I {} sh -c 'swift-format format --in-place \"$1\" && swiftlint lint --fix --quiet \"$1\"' _ {}"
          }
        ]
      }
    ]
  },
  "extraKnownMarketplaces": {
    "claude-kit": {
      "source": { "source": "github", "repo": "tyabu12/claude-kit" }
    }
  },
  "enabledPlugins": {
    "claude-kit@claude-kit": true
  }
}
