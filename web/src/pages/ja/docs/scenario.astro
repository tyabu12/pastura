---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { Code } from 'astro:components';
// JA mirror of /docs/scenario/ (#626). Content written from the ja preset YAML
// under Pastura/Pastura/Resources/Presets/ (prisoners_dilemma / word_wolf /
// bokete / target_score_race); how-to and observation tips mirror
// docs/examples/scenarios/README.md. AIgazing 系の genre word は使わない
// (lp-content.md の zoning に従い、ローカル等の具体語を使う)。語彙とトーンは
// LP (ja/index.astro) に合わせる (「複数の AI エージェント」「ローカル LLM」
// 「プリセット」「ペルソナ・フェーズ」「心の声」「観察/眺める」など)。
//
// 本文は 1 文を 1 行に収める (改行+インデントが HTML で半角スペースに潰れ、
// 文中に不自然なスペースが入るため。Latin 語まわりの空白は意図的に残す)。
//
// YAML サンプルはビルド時に Astro の <Code> (Shiki) でハイライト。静的 HTML
// で、クライアント JS は不要。波括弧のエスケープも Shiki 側が行う。
const prisonersDilemmaYaml = `name: 囚人のジレンマ
agents: 5
rounds: 3
context: >
  あなたはゲーム番組「囚人のジレンマ」の出場者です。
  対戦相手と「cooperate（協力）」か「betray（裏切り）」を選びます。
  両方協力=各3点 / 自分だけ裏切り=5点。

personas:
  - name: アキラ
    description: >
      【立場】冷静な戦略家。
      【目的】データと過去の行動から最適解を計算する。
  - name: ミサキ
    description: >
      【立場】お人好しの楽観主義者。
      【目的】基本的に人を信じる。裏切られても懲りない。

phases:
  - type: speak_all      # 全員に向けて宣言する
    output:
      statement: string
      inner_thought: string
  - type: choose         # 対戦相手ごとに協力／裏切りを選ぶ
    output:
      action: string
      inner_thought: string
    options:
      - cooperate
      - betray
    pairing: round_robin
  - type: score_calc     # 組み込みの prisoners_dilemma 集計
    logic: prisoners_dilemma
  - type: summarize      # ラウンドのスコアを総括
    template: >
      ラウンド{current_round}結果: {scoreboard}`;
---

<BaseLayout
  locale="ja"
  title="Pastura シナリオガイド"
  description="Pastura のシナリオ入門。シナリオとは何か、どう書くか、端末上で試せる例をまとめています。"
  enPath="/docs/scenario/"
  jaPath="/ja/docs/scenario/"
  variant="prose"
>
  <a class="skip-link" href="#main">本文へスキップ</a>

