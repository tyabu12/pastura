---
import BaseLayout from '../layouts/BaseLayout.astro';
// Body ported verbatim from the former pages/support/index.html (#475).
---

<BaseLayout
  locale="en"
  title="Pastura Support"
  description="Support and feedback channel for Pastura, an app for on-device AI multi-agent scenarios."
  enPath="/support/"
  jaPath="/ja/support/"
  variant="prose"
>
  <a class="skip-link" href="#main">Skip to content</a>

  <div class="page-shell">
    <header role="banner" class="lp-header">
      <a href="../" class="brand">
        <img class="icon" src="../img/app-icon.png" alt="" aria-hidden="true" width="36" height="36">
        <span class="brand-name">Pastura</span>
      </a>
      <nav aria-label="Primary" class="lp-nav">
        <div class="lang-toggle" role="group" aria-label="Language">
          <a lang="en" hreflang="en" aria-current="page" class="on" href="./">EN</a>
          <a lang="ja" hreflang="ja" href="../ja/support/">JA</a>
        </div>
      </nav>
    </header>

    <main id="main" class="page-main">
      <div class="page-prose">
        <h1>Pastura Support</h1>

        <p class="lead">
          Pastura is an app for running AI multi-agent scenarios fully on-device.
          Currently iOS-only. This page is the support and feedback channel for the app.
        </p>

        <h2 id="supported-devices">Supported devices</h2>

        <p>
          Pastura runs a large language model directly on your device, which needs roughly 6.5 GB of memory.
          In practice this means iPhone 15 Pro and later iPhones.
          The App Store hides Pastura on devices below this requirement.
        </p>

        <h2>Contact the maintainer</h2>

        <p>
          Use the contact form below to send feedback, bug reports, or questions.
          For general feedback, leave the Scenario ID field blank.
        </p>

        <p>
          <a href="https://docs.google.com/forms/d/e/1FAIpQLSfsZkY9-R3QxqVfdXSzsUnx3SXR-g9O7DxjdN-1-VtMjMXSAw/viewform">Open the contact form</a>
        </p>

        <p>
          You will receive an automatic acknowledgement at the email address you provide on the form.
          The maintainer reviews submissions and replies as needed.
        </p>

        <h3>Prefer a public tracker?</h3>

        <p>
          You can also file a <a href="https://github.com/tyabu12/pastura/issues/new">GitHub issue</a> on the project repository.
          This requires a GitHub account and is public.
        </p>

        <h2>Reporting a Shared Scenarios entry</h2>

        <p>
          To report a specific scenario shown in the in-app Shared Scenarios, use the <strong>Report</strong> button on the scenario's detail sheet inside the app.
          The in-app flow pre-fills the scenario identifier automatically; the destination is the same contact form above.
        </p>

        <p>
          Reports indicating clear policy violations are hidden from the gallery during triage.
          Triage is performed by the Pastura maintainer.
          The full report-handling policy is documented in <a href="https://github.com/tyabu12/pastura/blob/main/docs/decisions/ADR-005.md#6-shared-scenario-report-mechanism">ADR-005 §6</a>.
        </p>
      </div>
    </main>

    <footer role="contentinfo" class="lp-footer">
      <div class="foot-grid">
        <div>
          <a href="../" class="brand">
            <img class="icon" src="../img/app-icon.png" alt="" aria-hidden="true" width="36" height="36">
            <span class="brand-name">Pastura</span>
          </a>
        </div>
        <div>
          <h3 class="foot-h">Product</h3>
          <a class="foot-link" href="../#usage">Usage</a>
          <a class="foot-link" href="../#features">Features</a>
          <a class="foot-link" href="../#faq">FAQ</a>
        </div>
        <div>
          <h3 class="foot-h">Resources</h3>
          <a class="foot-link" href="../legal/privacy-policy/">Privacy Policy</a>
          <a class="foot-link" href="../docs/scenario/">Scenario guide</a>
          <a class="foot-link" href="https://github.com/tyabu12/pastura" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="foot-base">
        <span class="foot-copy">© 2026 Pastura</span>
        <div class="lang-toggle" role="group" aria-label="Language">
          <a lang="en" hreflang="en" aria-current="page" class="on" href="./">EN</a>
          <a lang="ja" hreflang="ja" href="../ja/support/">JA</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>
