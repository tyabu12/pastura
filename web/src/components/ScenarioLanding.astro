---
// Per-scenario share landing page body, shared by the English (`/s/<id>/`)
// and Japanese (`/ja/s/<id>/`) route files so the markup can never drift
// between locales. Each route passes the gallery entry + its own `locale`;
// the two routes are hreflang-paired by BaseLayout (#1071, Growth A-2).
//
// The scenario title/description are rendered in the entry's own `language`
// (the gallery has no cross-language translations — one entry, one language),
// so a page may show a Japanese title under English chrome when a viewer
// reaches the non-matching locale path. That is intentional: the title is
// user content, and the share card links to the sharer's own locale path.
//
// The highlight section (ADR-029) is read here rather than in the two route
// files so both routes stay identical by construction. Path resolution follows
// the routes' gallery.json read: `process.cwd()` is the web/ project root
// during `astro build`, and import.meta.url is unsafe (the bundler rewrites it
// to an unstable depth). `highlight_url` in gallery.json is NOT resolved by the
// web build — it exists for the app's index-anchored fetch (ADR-029 D5).
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { Code } from 'astro:components';
import BaseLayout from '../layouts/BaseLayout.astro';
import SheepAvatar from './SheepAvatar.astro';
import type { GalleryScenario, ScenarioHighlight } from '../types/gallery';

interface Props {
  locale: 'en' | 'ja';
  scenario: GalleryScenario;
}

const { locale, scenario } = Astro.props;
const isJa = locale === 'ja';

// Absence is the normal case (only a few curated scenarios have highlights),
// and a malformed file must not break the build — the repo-side gallery gate
// owns validation (ADR-029 D2), so the web build degrades to "no section".
function loadHighlight(id: string): ScenarioHighlight | null {
  const path = resolve(process.cwd(), `../docs/gallery/highlights/${id}.json`);
  let raw: string;
  try {
    raw = readFileSync(path, 'utf-8');
  } catch {
    return null; // no highlight for this scenario — render as before
  }
  try {
    const parsed = JSON.parse(raw) as ScenarioHighlight;
    if (
      parsed.schema_version !== 1 ||
      !Array.isArray(parsed.excerpt) ||
      parsed.excerpt.length === 0 ||
      typeof parsed.yaml_hook?.fragment !== 'string' ||
      typeof parsed.source?.model !== 'string' ||
      typeof parsed.teaser !== 'string'
    ) {
      console.warn(`[highlight] ignoring unusable highlight file: ${path}`);
      return null;
    }
    return parsed;
  } catch (err) {
    console.warn(`[highlight] ignoring unparseable highlight file: ${path} (${err})`);
    return null;
  }
}

const highlight = loadHighlight(scenario.id);

// The four avatar colour slots, in the order of `SheepAvatar.Character.allCases`
// (Pastura/Pastura/Views/Components/SheepAvatar.swift). The app resolves an
// agent's slot as `allCases[agentPosition % 4]`, where `agentPosition` is the
// agent's index in the scenario's persona list. A highlight file carries no
// persona index, so the order of first appearance in the excerpt stands in for
// it. Measured on both shipped highlights (chin_jimaku_v1, asch_conformity_v1):
// the two orders are identical, so a reader sees the same colours here as in
// the app. That includes asch_conformity_v1's collision, where five agents
// share four slots and 被験者ナオキ lands on サクラA's. The app collides the
// same way, so reproducing it is fidelity rather than a defect to route around.
const SHEEP_TONES = ['alice', 'bob', 'carol', 'dave'] as const;

const excerpt = highlight?.excerpt ?? [];

const agentSlots = new Map<string, number>();
for (const line of excerpt) {
  if (!agentSlots.has(line.agent)) agentSlots.set(line.agent, agentSlots.size);
}
const toneFor = (agent: string) =>
  SHEEP_TONES[(agentSlots.get(agent) ?? 0) % SHEEP_TONES.length];

// The panel head names the phase only when every line shares one, mirroring
// GameHeader's meta row, where each fragment renders or collapses on its own.
// ADR-029 Decision 3 allows an excerpt to mix phases, and labelling a mixed one
// after its first entry would be silently wrong.
const excerptPhases = new Set(excerpt.map((line) => line.phase));
const uniformPhase = excerptPhases.size === 1 ? [...excerptPhases][0] : null;

const enPath = `/s/${scenario.id}/`;
const jaPath = `/ja/s/${scenario.id}/`;

// Custom-scheme deep link — NOT the https Universal Link. A same-domain https
// link tapped inside Safari does not hand off to the app; the custom scheme
// reliably opens the installed app from a user gesture. Non-installed users
// simply get a no-op, then reach for the App Store badge below.
const openURL = `pastura://scenario/${scenario.id}`;

const t = isJa
  ? {
      titleSuffix: '｜Pastura',
      intro: 'このシナリオは Pastura の「みんなのシナリオ」の一つです。',
      openInApp: 'Pastura で開く',
      badgeAria: 'Pastura を App Store で',
      badgeImg: '/img/app-store-badge-ja.svg',
      meta: `${scenario.agent_count}エージェント · ${scenario.rounds}ラウンド`,
      skip: '本文へスキップ',
      navLabel: '主要',
      langGroup: '言語',
      productH: 'プロダクト',
      resourcesH: 'リソース',
      usage: '使い方',
      features: '特徴',
      faq: 'FAQ',
      privacy: 'プライバシーポリシー',
      guide: 'シナリオガイド',
      highlightH: '実行のようす',
      highlightNote: `実際に端末で動かした結果から抜き出した会話です（${highlight?.source?.model ?? ''}）。`,
      yamlHookH: 'この会話を生んだYAML',
      editInvite: 'このYAMLはアプリで開いてそのまま書き換えられます。設定を変えて、自分だけの展開を確かめてみてください。',
      recorded: '記録',
      roundLabel: (round: number, total: number) => `ラウンド ${round} / ${total}`,
      // Mirrors PhaseDisplayName.swift. ADR-029 Decision 3 limits excerpts to
      // the two speak phases, so anything else is unexpected and drops the
      // fragment rather than guessing a label for it.
      phaseLabel: (phase: string): string | null =>
        phase === 'speak_all' ? '発言' : phase === 'speak_each' ? '個別発言' : null,
      innerVoiceNote: 'アプリでは、発言の裏でそれぞれが何を考えていたかも読めます。',
    }
  : {
      titleSuffix: ' · Pastura',
      intro: 'This scenario is one of Pastura’s Shared Scenarios.',
      openInApp: 'Open in Pastura',
      badgeAria: 'Pastura on the App Store',
      badgeImg: '/img/app-store-badge-en.svg',
      meta: `${scenario.agent_count} agents · ${scenario.rounds} rounds`,
      skip: 'Skip to content',
      navLabel: 'Primary',
      langGroup: 'Language',
      productH: 'Product',
      resourcesH: 'Resources',
      usage: 'Usage',
      features: 'Features',
      faq: 'FAQ',
      privacy: 'Privacy Policy',
      guide: 'Scenario guide',
      highlightH: 'A glimpse of a run',
      highlightNote: `Lines taken from a real on-device run (${highlight?.source?.model ?? ''}).`,
      yamlHookH: 'The YAML behind these lines',
      editInvite: 'Open this YAML in the app and rewrite it in place. Change the setup and see where your own run goes.',
      recorded: 'RECORDED',
      roundLabel: (round: number, total: number) => `ROUND ${round} / ${total}`,
      // Mirrors PhaseDisplayName.swift. ADR-029 Decision 3 limits excerpts to
      // the two speak phases, so anything else is unexpected and drops the
      // fragment rather than guessing a label for it.
      phaseLabel: (phase: string): string | null =>
        phase === 'speak_all' ? 'Speak' : phase === 'speak_each' ? 'Speak Each' : null,
      innerVoiceNote: 'In the app you can also read what each agent was thinking behind the line it spoke.',
    };

// Built after `t` so the head can use the locale's own strings. The phase
// fragment collapses when the excerpt mixes phases (see `uniformPhase` above)
// or carries one this component has no label for.
const headLabel = highlight
  ? [
      t.roundLabel(excerpt[0].round, scenario.rounds),
      uniformPhase ? t.phaseLabel(uniformPhase) : null,
    ]
      .filter((fragment): fragment is string => Boolean(fragment))
      .join(' · ')
  : '';
---

<BaseLayout
  locale={locale}
  title={`${scenario.title}${t.titleSuffix}`}
  description={scenario.description}
  enPath={enPath}
  jaPath={jaPath}
  variant="prose"
>
  <a class="skip-link" href="#main">{t.skip}</a>

  <div class="page-shell">
    <header role="banner" class="lp-header">
      <a href="/" class="brand">
        <img class="icon" src="/img/app-icon.png" alt="" aria-hidden="true" width="36" height="36" />
        <span class="brand-name">Pastura</span>
      </a>
      <nav aria-label={t.navLabel} class="lp-nav">
        <div class="lang-toggle" role="group" aria-label={t.langGroup}>
          <a lang="en" hreflang="en" href={enPath} class={locale === 'en' ? 'on' : undefined} aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
          <a lang="ja" hreflang="ja" href={jaPath} class={locale === 'ja' ? 'on' : undefined} aria-current={locale === 'ja' ? 'page' : undefined}>JA</a>
        </div>
      </nav>
    </header>

    <main id="main" class="page-main">
      <div class="page-prose">
        <p class="scenario-eyebrow">{t.intro}</p>
        <h1 lang={scenario.language}>{scenario.title}</h1>
        <p class="scenario-meta">{t.meta}</p>
        <p class="lead" lang={scenario.language}>{scenario.description}</p>

        {highlight && (
          <section class="highlight" aria-labelledby="highlight-h">
            <h2 id="highlight-h">{t.highlightH}</h2>
            <p class="highlight-note">{t.highlightNote}</p>

            <div class="run-figure">
              <div class="run-figure-head">
                <span class="leaf" aria-hidden="true"></span>
                <span class="label">{headLabel}</span>
                <span class="rec" aria-hidden="true"><span class="rec-dot"></span>{t.recorded}</span>
              </div>

              <ol class="excerpt" lang={scenario.language}>
                {highlight.excerpt.map((line, index) => (
                  <li>
                    {index > 0 && line.round !== highlight.excerpt[index - 1].round && (
                      <div class="round-divider">{t.roundLabel(line.round, scenario.rounds)}</div>
                    )}
                    <div class="bubble-row">
                      <SheepAvatar tone={toneFor(line.agent)} />
                      <div class="bubble-stack">
                        <div class="bubble-name">{line.agent}</div>
                        <div class="bubble"><blockquote>{line.text}</blockquote></div>
                      </div>
                    </div>
                  </li>
                ))}
              </ol>
            </div>

            <p class="inner-voice-note">{t.innerVoiceNote}</p>
            <p class="highlight-teaser" lang={scenario.language}>{highlight.teaser}</p>

            <h3 class="yaml-hook-h">{t.yamlHookH}</h3>
            <div class="yaml-hook"><Code code={highlight.yaml_hook.fragment} lang="yaml" theme="github-light" /></div>
            <p class="yaml-hook-caption" lang={scenario.language}>{highlight.yaml_hook.caption}</p>

            <p class="highlight-invite">{t.editInvite}</p>
          </section>
        )}

        <p class="open-cta-row">
          <a class="open-cta" href={openURL}>{t.openInApp}</a>
        </p>

        <div class="badges">
          <a href="https://apps.apple.com/app/pastura-local-llms-simulator/id6788409688" target="_blank" rel="noopener" class="appstore-cta" aria-label={t.badgeAria}>
            <img class="appstore-img" src={t.badgeImg} alt="" aria-hidden="true" width="120" height="40" />
          </a>
        </div>
      </div>
    </main>

    <footer role="contentinfo" class="lp-footer">
      <div class="foot-grid">
        <div>
          <a href="/" class="brand">
            <img class="icon" src="/img/app-icon.png" alt="" aria-hidden="true" width="36" height="36" />
            <span class="brand-name">Pastura</span>
          </a>
        </div>
        <div>
          <h3 class="foot-h">{t.productH}</h3>
          <a class="foot-link" href="/#usage">{t.usage}</a>
          <a class="foot-link" href="/#features">{t.features}</a>
          <a class="foot-link" href="/#faq">{t.faq}</a>
        </div>
        <div>
          <h3 class="foot-h">{t.resourcesH}</h3>
          <a class="foot-link" href={isJa ? '/ja/legal/privacy-policy/' : '/legal/privacy-policy/'}>{t.privacy}</a>
          <a class="foot-link" href={isJa ? '/ja/docs/scenario/' : '/docs/scenario/'}>{t.guide}</a>
          <a class="foot-link" href="https://github.com/tyabu12/pastura" rel="noopener">GitHub</a>
        </div>
      </div>
      <div class="foot-base">
        <span class="foot-copy">© 2026 Pastura</span>
        <div class="lang-toggle" role="group" aria-label={t.langGroup}>
          <a lang="en" hreflang="en" href={enPath} class={locale === 'en' ? 'on' : undefined} aria-current={locale === 'en' ? 'page' : undefined}>EN</a>
          <a lang="ja" hreflang="ja" href={jaPath} class={locale === 'ja' ? 'on' : undefined} aria-current={locale === 'ja' ? 'page' : undefined}>JA</a>
        </div>
      </div>
    </footer>
  </div>
</BaseLayout>

<style>
  /* Scoped to the landing page — a primary "open in app" action that reads as
     the page's hero CTA, above the (disabled) App Store badge. Mirrors the
     design-system moss accent without pulling in the full lp.css. */
  .scenario-eyebrow {
    font-size: 0.85rem;
    letter-spacing: 0.02em;
    color: var(--ink-secondary, #5b6152);
    margin-bottom: 0.5rem;
  }
  .scenario-meta {
    font-size: 0.9rem;
    color: var(--ink-secondary, #5b6152);
    margin-top: -0.25rem;
  }
  .open-cta-row {
    margin: 1.75rem 0 0.75rem;
  }
  .open-cta {
    display: inline-block;
    padding: 0.7rem 1.4rem;
    border-radius: 999px;
    background: var(--moss, #4f6d3a);
    color: #fff;
    font-weight: 600;
    text-decoration: none;
  }
  .open-cta:hover,
  .open-cta:focus-visible {
    background: var(--moss-dark, #3d5a2b);
  }

  /* Highlight section (ADR-029) — static curated excerpt of a real run.
     Deliberately plain markup, no client-side script: this is text, not a
     replay surface (ADR-029 Decision 6 keeps it outside the Phase-3 line). */
  .highlight {
    margin: 2.5rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--rule, #e2e4dd);
  }
  .highlight-note,
  .yaml-hook-caption {
    font-size: 0.85rem;
    color: var(--ink-secondary, #5b6152);
  }
  /* The excerpt is drawn as the app draws a run: sheep avatar, name, bubble.
     `.bubble-row` / `.sheep` / `.bubble` / `.bubble-name` come from base.css,
     which is loaded on prose pages too, so only the surrounding panel is new.

     That panel repeats the LP hero figure's vocabulary (`.lp-hero-figure` in
     lp.css) instead of sharing it. lp.css is not loaded on a prose page, and
     lifting the chrome into base.css would put new selectors on the LP's
     cascade to serve a single consumer. Keeping the rules scoped also settles
     the specificity question: page.css loads AFTER base.css, so a global
     `.run-figure ol` would tie with `.page-prose ol` and lose, whereas Astro's
     scoping puts these at two classes and they win. */
  .run-figure {
    background: var(--page, #f3efe7);
    border: 1px solid var(--rule, #e0dbce);
    border-radius: 18px;
    padding: 22px 18px;
    margin: 1.25rem 0 1.5rem;
  }
  @media (min-width: 48rem) {
    .run-figure {
      padding: 26px 24px;
    }
  }
  .run-figure-head {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 16px;
  }
  .run-figure-head .leaf {
    width: 8px;
    height: 8px;
    background: var(--moss, #8a9a6c);
    transform: rotate(45deg);
    display: inline-block;
  }
  .run-figure-head .label {
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--ink-2, #5a5a55);
  }
  /* The LP's twin of this pill reads SIMULATING against a pulsing moss dot.
     An excerpt is an archived run, so the dot stays still and the colour drops
     to muted. Faking liveness here would be the one dishonest pixel on a page
     whose whole claim is that these lines really happened. */
  .run-figure-head .rec {
    margin-left: auto;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.12em;
    color: var(--muted, #6b6b65);
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .run-figure-head .rec-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--muted, #6b6b65);
  }
  .excerpt {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .excerpt > li {
    margin: 0;
  }
  /* An excerpt may cross a round boundary (asch_conformity_v1 does), and
     without a marker the jump reads as two agents talking past each other.
     Readable rather than decorative, so a screen reader gets the same cue. */
  .round-divider {
    display: flex;
    align-items: center;
    gap: 10px;
    font-family: "JetBrains Mono", ui-monospace, monospace;
    font-size: 10px;
    letter-spacing: 0.22em;
    color: var(--muted, #6b6b65);
    margin: 6px 0 14px;
  }
  .round-divider::after {
    content: "";
    flex: 1;
    height: 1px;
    background: var(--rule, #e0dbce);
  }
  .excerpt .bubble blockquote {
    /* Long unbroken agent output must wrap rather than widen the page. */
    overflow-wrap: anywhere;
  }
  .inner-voice-note {
    font-size: 0.85rem;
    color: var(--ink-secondary, #5b6152);
  }
  .yaml-hook-h {
    font-size: 1rem;
    margin-bottom: 0.5rem;
  }
  /* `<Code>` highlights the fragment at build time via Shiki, the same
     treatment the scenario format reference gets — there the Markdown fences
     inherit it from `astro.config.mjs`'s pinned `github-light`, here the theme
     is named explicitly. The panel chrome (monospace, border, padding,
     overflow-x: auto) still comes from page.css `.page-prose pre`, which this
     block sits inside, so long YAML lines scroll within the block and the page
     body never gains a horizontal scrollbar on narrow screens.

     The wrapper exists because `<Code>` emits its own `<pre>`, which carries no
     scope attribute from this component — hence the `:global()` reach to pull
     the caption back up under it. */
  .yaml-hook {
    max-width: 100%;
    margin-bottom: 0.5rem;
  }
  .yaml-hook :global(pre.astro-code) {
    margin-bottom: 0;
  }
  .highlight-teaser {
    font-weight: 600;
  }
  .highlight-invite {
    font-size: 0.9rem;
    color: var(--ink-secondary, #5b6152);
  }
</style>
