# Xcode
build/
DerivedData/

# Xcode metadata file written as a SIBLING of workspace-relative DerivedData
# (at Pastura/.derived-data-log-*, not inside DerivedData/), so the rule above
# doesn't cover it.
.derived-data-log-*
Pastura/Pastura.xcodeproj/project.xcworkspace/xcuserdata/
Pastura/Pastura.xcodeproj/xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# CocoaPods (if used for LiteRT-LM)
Pods/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# Fastlane dotenv — ASC credential identifiers (ADR-014, docs/release-setup.md).
# Bare-name line is mandatory: `fastlane/.env.*` alone would NOT match the
# suffix-less `fastlane/.env`, leaving the live credential file tracked. The
# negation (kept last so it wins) keeps the committed template tracked.
fastlane/.env
fastlane/.env.*
!fastlane/.env.example

# App Store Connect / APNs private keys (ADR-014 § Secrets). Global, not
# scoped to fastlane/ — a key must never enter the tree at any path. The
# p8-precommit-gate.sh gate is the defense-in-depth backstop for `git add -f`.
*.p8
AuthKey_*.p8

# IDE
*.swp
*~
.idea/
.vscode/

# LLM model files (large, should not be in repo)
*.litertlm
*.gguf

# Python bytecode cache (e.g. from scripts/*.py via `python3 -m py_compile`).
__pycache__/
*.pyc

# Scenario-factory raw run logs and generated candidate YAMLs (ADR-013 /
# #515 / #521) — local-only.
data/factory/runs/
data/factory/scenarios/

# Scenario-refine (/scenario-refine #730) raw run logs and A/B improvement
# candidate YAMLs — local-only. The skill's hard safety boundary is that it
# writes ONLY under data/factory/; these gitignores keep that output channel
# untracked so an errant write can never reach users (the skill never commits
# or pushes — a stray write stays a dirty working tree).
data/factory/audit-runs/
data/factory/improvements/

# Nightly-routine digests — local judging / run journals appended in place
# by the scenario-factory / queue-consumer skills. Untracked so the main
# checkout's working tree stays clean; each skill's append_digest.py
# bootstraps the file from a scaffold if absent.
data/factory/digest.md
data/factory/digest-index.jsonl
data/factory/audit-digest.md
data/queue/digest.md
data/factory/lessons-inbox.md

# Harness transcripts backing gallery highlights (ADR-029) — local-only by
# decision: the pre-commit human sign-off is the sole durable record of a
# highlight's provenance (#1384), so the JSONLs referenced by each
# highlight's source.run_id stay out of the repo.
data/highlight-runs/

# /model-eval raw run logs and scorecard journal — local-only, same
# untracked-output-channel rationale as the scenario-factory/-refine block
# above (the skill never commits or pushes; a stray write stays a dirty
# working tree). append_eval.py bootstraps eval-digest.md from a scaffold
# if absent.
data/models/eval-runs/
data/models/eval-digest.md

# Per-user Claude Code settings — permission grants and opt-in hooks such as
# the worktree pruner (CLAUDE.md § Automated hooks). Machine-local by design:
# the tracked .claude/settings.json is the shared configuration. Ignored here
# rather than relying on a contributor's global gitignore, so the CLAUDE.md
# instruction to wire opt-in hooks there is safe for everyone.
.claude/settings.local.json

# Worktree-pruner decision log — appended by scripts/prune-stale-worktrees.sh
# when it removes (or would remove) something, or when an unrecognized ignored
# file blocks a removal. Local-only: which worktrees this machine accumulated
# is machine state, and the pruner is opt-in per user (CLAUDE.md § Automated
# hooks). Absent until the first non-idle run; the script creates it.
data/worktree-prune.log

# Design-review screenshots — generated on demand by scripts/ui-tour.sh
# (see docs/design/screenshots/README.md). Only the README is tracked.
# The first pattern is single-level, so the `--dark` set needs its own line —
# without it those PNGs surface as untracked and can be committed by accident.
docs/design/screenshots/*.png
docs/design/screenshots/dark/

# App Store submission screenshots — captured locally per docs/store/screenshot-plan.md.
# Never committed (large binaries; regenerated per submission).
docs/store/screenshots/

# Zenn-article inference screenshots — generated on demand by
# scripts/marketing-shots.sh (see docs/marketing/launch-transcripts.md).
# Never committed (derived binaries; the verbatim transcripts are the record).
docs/marketing/screenshots/

# Design-review motion captures — generated on demand by
# scripts/motion-capture.sh (see docs/design/motion/README.md). Only the
# README is tracked.
docs/design/motion/*
!docs/design/motion/README.md

# ui-refine per-run digests — generated by the ui-refine skill (see
# docs/design/ui-refine/README.md). Only the README is tracked; the durable
# record is the committed docs/design/ui-refine/ledger.md.
docs/design/ui-refine/digests/*
!docs/design/ui-refine/digests/README.md

# code-health-audit generated output — per-run digests plus the cross-run dedup
# ledger, both written by the code-health-audit skill (see
# docs/code-health/README.md). Only the README is tracked; the ledger is
# local-only dedup memory (a fresh clone / git clean -fdx wipes it), and the
# durable record is the filed issues promotion creates.
docs/code-health/digests/*
!docs/code-health/digests/README.md
docs/code-health/ledger.md

# Astro web project (web/ — the pastura.app site). Build output and
# dependencies are local-only; package-lock.json IS tracked for
# reproducible `npm ci` in CI.
web/node_modules/
web/dist/
web/.astro/

# Gradle / Kotlin (KMP integration — Issue #220 / #501 Stage 1). `build/` is
# already ignored above (Xcode rule), which also covers `shared/<module>/build/`
# for Gradle module outputs.
.gradle/
local.properties
# Kotlin 2.x per-project scratch (`sessions/`, `errors/`). Created in the CWD by
# any `./gradlew` invocation, so it dirties the tree of anyone doing KMP work —
# routine since the Stage-2 engine slice. Sibling gap to `.gradle/` above.
.kotlin/

