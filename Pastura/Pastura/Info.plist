<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Build-setting substitution, not a literal: the Debug configuration suffixes
	     PRODUCT_BUNDLE_IDENTIFIER (app.pastura.Pastura.dev) so a dev build can be
	     installed alongside the App Store build. BackgroundSimulationManager.taskIdentifier
	     derives the same way; BGTaskScheduler.register only logs when it rejects an
	     unpermitted identifier, so a divergence here is silent at build AND run time.
	     Sole source for this key — the duplicate INFOPLIST_KEY_ build setting was
	     removed so precedence between the two is not something anything relies on.

	     The App Store side rests on BUNDLE_ID_SUFFIX being EMPTY in the Release
	     config, paired with scripts/release.sh pinning -configuration Release.
	     Nothing tests that pairing: the suite builds Debug, so deleting the empty
	     Release definition would ship a `.dev` binary with a green suite. Treat the
	     Release block's BUNDLE_ID_SUFFIX = "" as load-bearing, not as dead weight
	     that could be tidied away. -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).simulation-continuation</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<!-- Substituted for the same reason as the BGTask identifier above, so
			     the file has no bundle-ID-shaped literal left. This is the URL
			     type's abstract *name*, not the scheme — the scheme below stays
			     `pastura` in both configurations, and which of two installed apps
			     opens a `pastura://` URL is a deliberately accepted ambiguity. -->
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).scenario</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pastura</string>
			</array>
		</dict>
	</array>
	<!-- Facebook App ID for "Share to Instagram Stories" (#1083).
	     Required by Instagram since Jan 2023: passed as the
	     `source_application` query param of `instagram-stories://share`.
	     A free, PUBLIC client identifier (NOT a secret) — obtain one at
	     developers.facebook.com (register → create app → copy the App ID)
	     and paste it below. While this stays empty the Instagram Stories
	     share path stays dark: `InstagramStoriesSharer.isAvailable` gates on
	     a non-empty value, so the share button falls through to the system
	     share sheet unchanged. -->
	<key>FacebookAppID</key>
	<string>4307199252924586</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
	</array>
	<!-- Add-only Photos access for the highlight-card "Save Image" share action
	     (#1096). Purpose string is deliberately specific (App Store Guideline
	     5.1.1) and localized via InfoPlist.xcstrings - Info.plist strings sit
	     outside the Localizable.xcstrings automated i18n gate, so the ja
	     translation lives in that catalog, not the coverage gate. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Pastura saves the highlight card image to your photo library when you tap Save Image.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>launchScreenBackground</string>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<!-- Sole entry by design: pairing with ipad-minimum-performance-m1
	     blocks iPhone installs entirely (Apple Dev Forums thread 773898).
	     This key alone limits installs to iPhone 15 Pro-equivalent+ and
	     iPad M1+, matching ModelRegistry.minRAM (6.5 GB). One-way door:
	     updates may only maintain or relax capability requirements. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>iphone-performance-gaming-tier</string>
	</array>
	<!-- No `UIUserInterfaceStyle` key: the app follows the device appearance.
	     It carried `Light` from #1273 until #1284 — a defensive lock, because
	     dark mode would otherwise flip the token-less default SwiftUI chrome
	     while the not-yet-paired tokens stayed put, leaving unreadable
	     mixed-appearance screens. All five of ADR-028 § "Rollout"'s gate
	     conditions are now met, the last two by real-device QA, so the lock is
	     removed rather than updated. Re-adding it is not a small change: it
	     would silently strand 69 designed dark token pairs, the paired
	     `launchScreenBackground` / `AccentColor` colorsets and the dark
	     share-card path. Read ADR-028 first. -->
</dict>
</plist>
