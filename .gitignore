# Xcode
build/
DerivedData/

# Xcode metadata file written as a SIBLING of workspace-relative DerivedData
# (at Pastura/.derived-data-log-*, not inside DerivedData/), so the rule above
# doesn't cover it.
.derived-data-log-*
Pastura/Pastura.xcodeproj/project.xcworkspace/xcuserdata/
Pastura/Pastura.xcodeproj/xcuserdata/
*.pbxuser
*.mode1v3
*.mode2v3
*.perspectivev3
*.moved-aside

# Swift Package Manager
.build/
.swiftpm/

# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# CocoaPods (if used for LiteRT-LM)
Pods/

# Fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output

# IDE
*.swp
*~
.idea/
.vscode/

# LLM model files (large, should not be in repo)
*.litertlm
*.gguf

# Python bytecode cache (e.g. from scripts/*.py via `python3 -m py_compile`).
__pycache__/
*.pyc

# Gradle / Kotlin (KMP integration — Issue #220)
# `build/` is already ignored above (Xcode rule), which also covers
# `shared/<module>/build/` for Gradle module outputs.
.gradle/
local.properties

# KMP XCFramework drop (Issue #220 W3 PR-A). Built by
# `scripts/kmp/assemble-xcframework.sh` from `shared/models/`. Gitignored
# because the binary is reproducible from `shared/` source. The pattern
# is xcframework-specific (NOT directory-level) so `Pastura/Frameworks/README.md`
# remains checked in.
Pastura/Frameworks/*.xcframework
