<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>app.pastura.Pastura.simulation-continuation</string>
	</array>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>app.pastura.Pastura.scenario</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>pastura</string>
			</array>
		</dict>
	</array>
	<!-- Facebook App ID for "Share to Instagram Stories" (#1083).
	     Required by Instagram since Jan 2023: passed as the
	     `source_application` query param of `instagram-stories://share`.
	     A free, PUBLIC client identifier (NOT a secret) — obtain one at
	     developers.facebook.com (register → create app → copy the App ID)
	     and paste it below. While this stays empty the Instagram Stories
	     share path stays dark: `InstagramStoriesSharer.isAvailable` gates on
	     a non-empty value, so the share button falls through to the system
	     share sheet unchanged. -->
	<key>FacebookAppID</key>
	<string>4307199252924586</string>
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>instagram-stories</string>
	</array>
	<!-- Add-only Photos access for the highlight-card "Save Image" share action
	     (#1096). Purpose string is deliberately specific (App Store Guideline
	     5.1.1) and localized via InfoPlist.xcstrings - Info.plist strings sit
	     outside the Localizable.xcstrings automated i18n gate, so the ja
	     translation lives in that catalog, not the coverage gate. -->
	<key>NSPhotoLibraryAddUsageDescription</key>
	<string>Pastura saves the highlight card image to your photo library when you tap Save Image.</string>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>launchScreenBackground</string>
		<key>UIImageName</key>
		<string>LaunchIcon</string>
		<key>UIImageRespectsSafeAreaInsets</key>
		<true/>
	</dict>
	<!-- Sole entry by design: pairing with ipad-minimum-performance-m1
	     blocks iPhone installs entirely (Apple Dev Forums thread 773898).
	     This key alone limits installs to iPhone 15 Pro-equivalent+ and
	     iPad M1+, matching ModelRegistry.minRAM (6.5 GB). One-way door:
	     updates may only maintain or relax capability requirements. -->
	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>iphone-performance-gaming-tier</string>
	</array>
	<!-- Defensive light-mode lock (#1273). Without this, system dark mode
	     flips the token-less default SwiftUI chrome (List/Form/sheet
	     backgrounds, .primary labels, nav bars) plus the trait-paired tokens
	     below, while the still-light-only tokens stay put — leaving
	     unreadable mixed-appearance screens. Info.plist over
	     `.preferredColorScheme(.light)` so the lock also covers
	     UIKit-presented surfaces (share sheets) and the launch screen, not
	     just the SwiftUI hierarchy.

	     UPDATED (ADR-028, #1282): the §2.9 dark tokens are no longer unwired —
	     26 pairs now resolve trait-based via `PasturaDynamicPalette`. Removal
	     is still blocked, starting with the remaining light-only tokens
	     having no dark counterpart. Do NOT delete this key just because the mechanism
	     exists; ADR-028 § "Rollout" lists all 5 gate conditions. Two are met —
	     `nightSurface` resolved (deleted, #1282) and raw-SwiftUI-color sites
	     tokenized (#1283); the open three are the remaining 42 designed values,
	     real-device QA, and the dark share-card re-verification.
	     Tracked in #1274. -->
	<key>UIUserInterfaceStyle</key>
	<string>Light</string>
</dict>
</plist>
